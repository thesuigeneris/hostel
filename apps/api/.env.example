# Postgres from `docker compose up -d` at the repo root
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hostels
PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# standard = real users. demo = public demo: only seeded demo accounts sign in, no sign-ups, no SMS,
# payments always simulated. On NODE_ENV=production + standard, demo accounts can never sign in.
APP_MODE=standard
# Demo accounts in development (on by default outside production; ignored in production standard)
DEMO_LOGIN=on

# Phones that become admin after a verified OTP login (comma-separated). 9000000001 is the seeded demo
# admin, fine for dev; in production list real phones, or use `bun run admin:grant <phone>` when SMS is off.
ADMIN_PHONES=9000000001
# Secret mixed into stored OTP hashes; set a long random value outside dev
OTP_PEPPER=dev-otp-pepper
# Signs upload receipts and private photo links. A different long random value from OTP_PEPPER outside dev.
# With NODE_ENV=production the API refuses to start on these development values (see docs/RUN.md).
UPLOAD_SIGNING_SECRET=dev-upload-signing-secret

# 1 only when every request reaches the API through your own proxy (Caddy in deploy/compose.prod.yml, which sets it)
# or the website: then the last X-Forwarded-For entry is the client's address for rate limits. Leave unset when the
# API is reached directly, so nobody can claim another address.
TRUST_PROXY=
# Rate limits (apps/api/src/lib/rate-limit.ts). Per-rule overrides as rule=requests/seconds, e.g. login=30/600.
# RATE_LIMIT_FACTOR multiplies every limit; tests raise it. Production refuses a factor above 1.
RATE_LIMITS=
RATE_LIMIT_FACTOR=

# Leave empty for stub mode in dev (OTP is always 123456). In production without these, text-message login is
# off and people use phone + password (no SMS cost).
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Leave empty for stub mode (simulated payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
