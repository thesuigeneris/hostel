# Postgres from `docker compose up -d` at the repo root
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hostels
PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Phones that become admin on login (comma-separated)
ADMIN_PHONES=9000000001
# Secret mixed into stored OTP hashes; set a long random value outside dev
OTP_PEPPER=dev-otp-pepper

# Leave empty for stub mode (OTP is always 123456)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Leave empty for stub mode (simulated payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
