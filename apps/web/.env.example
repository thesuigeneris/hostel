# Where the Next.js server reaches the API (server-side only)
API_URL=http://localhost:4000
# Public site URL, used for canonical links, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Where browsers load uploaded photos from, if different from API_URL (e.g. a public hostname).
# Read at build time: it is the only photo origin the Content Security Policy allows.
# API_PUBLIC_URL=https://api.example.com
# Map tiles (optional): free OpenStreetMap tiles when unset. To scale, a provider's raster tile URL with {z}/{x}/{y}
# (and its key) and the credit line it asks for. Read at build time. See docs/RUN.md, "Maps".
# NEXT_PUBLIC_MAP_TILE_URL=https://tiles.example.com/{z}/{x}/{y}.png?key=...
# NEXT_PUBLIC_MAP_ATTRIBUTION=© Example, © OpenStreetMap contributors
