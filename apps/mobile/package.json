{
  "name": "@hostels/mobile",
  "version": "0.0.1",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "export:android": "expo export --platform android",
    "assets": "python3 scripts/generate-assets.py",
    "prebuild:android": "expo prebuild --platform android --clean",
    "build:android:debug": "expo prebuild --platform android --clean && cd android && ./gradlew assembleDebug",
    "build:android:release": "APP_VARIANT=production expo prebuild --platform android --clean && cd android && ./gradlew assembleRelease",
    "eas:preview": "eas build --platform android --profile preview",
    "eas:production": "eas build --platform android --profile production",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@hostels/shared": "workspace:*",
    "expo": "58.0.19",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.13",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-location": "~58.0.19",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-maps": "1.29.11",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~19.3.0",
    "typescript": "^5.4.0"
  }
}
