{
  "name": "hostels",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:migrate": "bun --filter @hostels/api db:migrate",
    "db:seed": "bun --filter @hostels/api db:seed",
    "db:reset": "bun --filter @hostels/api db:reset",
    "dev:api": "bun --filter @hostels/api dev",
    "dev:mobile": "bun --filter @hostels/mobile start",
    "test": "bun --filter '*' test",
    "typecheck": "bun --filter '*' typecheck",
    "lint": "biome lint ."
  },
  "packageManager": "bun@1.3.10",
  "devDependencies": {
    "@biomejs/biome": "1.9.4"
  }
}
