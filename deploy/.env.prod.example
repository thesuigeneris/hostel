# Copy to deploy/.env.prod (never commit it) and fill in. docs/DEPLOY.md explains each step.
# The API checks these when it starts and refuses to run, listing every problem, if something is unsafe.

# --- Database (only the API reaches it) ---
POSTGRES_PASSWORD=change-me-to-a-long-random-value

# --- Public addresses (https; Caddy serves both when you run with the `tls` profile) ---
SITE_DOMAIN=example.in
API_DOMAIN=api.example.in
ACME_EMAIL=you@example.in
WEB_URL=https://example.in
API_PUBLIC_URL=https://api.example.in
CORS_ORIGINS=https://example.in

# --- Secrets: two different values, e.g. `openssl rand -hex 32` each ---
OTP_PEPPER=
UPLOAD_SIGNING_SECRET=

# --- Who runs the platform ---
# standard = real users; demo = a public demo with seeded accounts only and simulated payments.
APP_MODE=standard
# Phones that become admin after an OTP-verified login. Without SMS, use `bun run admin:grant <phone>` (see DEPLOY.md).
ADMIN_PHONES=

# --- Optional: OTP texts. Leave both empty for phone + password login only. ---
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# --- Optional: payments. Without keys, a standard instance takes no payments at all. ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Image tag, to roll back to an earlier build ---
TAG=latest

# Map tiles (optional). Empty: free OpenStreetMap tiles. To scale, a provider's raster tile URL with {z}/{x}/{y} and its
# key, and the credit line it asks for. Changing them needs a rebuild of the web image. See docs/RUN.md, "Maps".
MAP_TILE_URL=
MAP_ATTRIBUTION=
